  Cache-Control: public, max-age=86400
/pkg/*
  Cache-Control: no-cache
/*.wasm
  Content-Type: application/wasm

/library/catalog.json
  Cache-Control: no-cache
/library/index.json.gz
  Cache-Control: no-cache
